.DEFAULT_GOAL := help

BUILD_DIR ?= build
VM_MEMORY ?= 4G
VM_CPUS ?= 2
VM_DISPLAY ?= vnc=127.0.0.1:0

.PHONY: help setup build test vm-image qemu-install qemu stop-qemu guest-sdk automate-windows

help:
	@printf '%s\n' \
	  'Windows eBPF Sandbox' \
	  '' \
	  'make setup        Install Linux host tools and configure CMake' \
	  'make build        Build Asio app and pinned XDP/socket-address BPF objects' \
	  'make test         Run smoke test and verify generated BPF ELF objects' \
	  'make vm-image     Download Windows Server 2022 ISO and create guest media' \
	  'make qemu-install Launch the Windows installer in a persistent VNC VM' \
	  'make qemu         Start the installed Windows VM in persistent VNC mode' \
	  'make stop-qemu    Stop the QEMU VM started by this Makefile' \
	  'make guest-sdk    Print the Windows guest SDK/WDK setup instructions' \
	  'make automate-windows Run unattended Windows setup, guest bootstrap, build, and tests'

setup:
	./scripts/setup.sh

build:
	cmake -S eBPF_boost_asio_design -B $(BUILD_DIR)
	cmake --build $(BUILD_DIR) --parallel

test: build
	./$(BUILD_DIR)/asio_smoke_test
	llvm-readelf -h $(BUILD_DIR)/bpf/xdp_pass.bpf.o | grep -q EM_BPF
	llvm-readelf -S $(BUILD_DIR)/bpf/bind_policy.bpf.o | grep -q 'cgroup/bind4'
	llvm-readelf -S $(BUILD_DIR)/bpf/bind_policy.bpf.o | grep -q 'cgroup/bind6'

vm-image:
	./scripts/setup.sh --download-windows-iso

qemu-install: vm-image
	WIN_VM_DAEMONIZE=1 WIN_VM_BOOT_ORDER=dc WIN_VM_MEMORY=$(VM_MEMORY) WIN_VM_CPUS=$(VM_CPUS) WIN_VM_DISPLAY=$(VM_DISPLAY) ./scripts/run-windows-qemu.sh

qemu:
	@test -f $(BUILD_DIR)/windows.qcow2 || { printf 'VM disk is missing; run make qemu-install first.\n' >&2; exit 1; }
	WIN_VM_DAEMONIZE=1 WIN_VM_MEMORY=$(VM_MEMORY) WIN_VM_CPUS=$(VM_CPUS) WIN_VM_DISPLAY=$(VM_DISPLAY) ./scripts/run-windows-qemu.sh

stop-qemu:
	@test -f $(BUILD_DIR)/windows-qemu.pid || { printf 'No QEMU pid file found.\n'; exit 0; }
	@pid=$$(cat $(BUILD_DIR)/windows-qemu.pid); \
	  if kill -0 "$$pid" 2>/dev/null && ps -p "$$pid" -o args= | grep -q '[q]emu-system'; then \
	    kill "$$pid"; printf 'Stopped QEMU PID %s.\n' "$$pid"; \
	  else printf 'QEMU PID file is stale.\n'; fi
	@rm -f $(BUILD_DIR)/windows-qemu.pid

guest-sdk:
	@printf '%s\n' \
	  'Windows SDK/WDK must be installed inside the Windows VM, not on the Linux host.' \
	  'In an elevated PowerShell in the guest, run setup-windows-guest.ps1 from the WINDOWS_DEV_TOOLS CD.' \
	  'That script is generated by make vm-image and verifies pinned Microsoft setup/config hashes.'

automate-windows:
	python3 ./scripts/automate-windows-vm.py
